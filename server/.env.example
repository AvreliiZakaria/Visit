# Порт сервера
PORT=8080

# Секрет для подписи токенов и хеширования device id. Обязательно смени в проде.
JWT_SECRET=change-me-to-a-long-random-string

# Токен для админских ручек (/api/admin/*)
ADMIN_TOKEN=change-me-too

# Где лежит база и аудио
DATA_DIR=./data

# Размер жюри и минимальный кворум для вердикта по таймауту
JURY_SIZE=100
JURY_SIZE_WIDE=1000
MIN_QUORUM=20

# Сроки: бесплатное дело в часах, срочное в минутах
FREE_DEADLINE_HOURS=24
URGENT_DEADLINE_MINUTES=30

# Порог прослушивания, ниже которого голос не принимается
LISTEN_THRESHOLD=0.8

# Минимальное время от выдачи дела до голоса, секунды
MIN_DELIBERATION_SECONDS=15

# Разрешённый источник для CORS. Пусто = только своя раздача статики.
ALLOW_ORIGIN=
