# ---- обязательное ----
# Секрет для подписи сессий. Сгенерируй свой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_random_64_chars

# ---- сервер ----
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# ---- база и файлы ----
DB_PATH=./data/verdict.sqlite
UPLOAD_DIR=./uploads
MAX_AUDIO_MB=8

# ---- правила суда ----
JURY_TARGET_FREE=100
JURY_TARGET_WIDE=1000
# Ниже этого числа голосов вердикт не выносится никогда
JURY_MIN_QUORUM=30
DEADLINE_FREE_HOURS=24
DEADLINE_URGENT_MINUTES=30
OPPONENT_WINDOW_HOURS=24
# Антифрод: минимум секунд между выдачей дела и голосом
MIN_SECONDS_BEFORE_VOTE=15
# Доля прослушивания каждой стороны, ниже которой голос не принимается
MIN_LISTEN_RATIO=0.8

# ---- транскрибация, нужна для модерации ----
# Без ключа транскрипта нет. Если MODERATION_STRICT=true, дела уходят на ручную проверку.
OPENAI_API_KEY=
MODERATION_STRICT=false

# ---- платежи ----
# Пусто = песочница: покупка подтверждается локально, деньги не двигаются.
# С ключом = настоящий Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_URGENT_CENTS=300
PRICE_WIDE_CENTS=500
PRICE_SUB_CENTS=700

# ---- первый администратор ----
ADMIN_EMAIL=
